FLASK_APP=wsgi.py
FLASK_ENV=development

# PostgreSQL — local development defaults
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=eventflow
POSTGRES_USER=eventflow_user
POSTGRES_PASSWORD=changeme_strong_password

# JWT — change these in production
SECRET_KEY=dev-secret-key-replace-me
JWT_SECRET_KEY=dev-jwt-secret-replace-me

# CORS — allow local Vite dev server
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# Testing
TEST_DATABASE_URL=postgresql://eventflow_user:changeme_strong_password@localhost:5432/eventflow_test
