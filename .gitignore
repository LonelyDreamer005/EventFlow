.env.local
.env.production
.env.*.local
backend/.env
frontend/.env
k8s/secret.yaml
*.pem
*.key
*.p12
*.pfx

# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
pip-log.txt
pip-delete-this-directory.txt
*.pyo

# Virtual environments
venv/
.venv/
env/
ENV/
.virtualenv/

# pytest / coverage
.pytest_cache/
.cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
*.py,cover
nosetests.xml
coverage/

# mypy / ruff
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/

# ─── Node / Frontend ─────────────────────────────────────────────────────────
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# Vite / build output
frontend/dist/
frontend/build/
dist/
build/

# ─── Database ────────────────────────────────────────────────────────────────
*.sqlite3
*.db
*.sql.bak
postgres-data/
data/
instance/
backend/instance/

# ─── Docker ──────────────────────────────────────────────────────────────────
docker-compose.override.yml.local

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
logs/
backend/logs/
frontend/logs/

# ─── OS & Editor ─────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# VSCode
.vscode/
*.code-workspace

