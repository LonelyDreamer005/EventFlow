apiVersion: v1
kind: Secret
metadata:
  name: eventflow-secrets
  namespace: eventflow
  labels:
    app.kubernetes.io/name: eventflow
    app.kubernetes.io/part-of: eventflow-platform
type: Opaque
stringData:
  POSTGRES_USER: "eventflow_user"
  POSTGRES_PASSWORD: "eventflow_secure_password_replace_in_prod"
  DATABASE_URL: "postgresql://eventflow_user:eventflow_secure_password_replace_in_prod@postgres-service:5432/eventflow"
  JWT_SECRET_KEY: "k8s-production-jwt-secret-replace-with-high-entropy-random-string"
  SECRET_KEY: "k8s-production-flask-secret-replace-with-high-entropy-random-string"
