# =============================================================================
# EventFlow — Root Environment Variables Example
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.
# =============================================================================

# ─── Flask ───────────────────────────────────────────────────────────────────
FLASK_APP=app
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string-in-production

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-another-long-random-string

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=eventflow
POSTGRES_USER=eventflow_user
POSTGRES_PASSWORD=changeme_strong_password

# Assembled from the above by the application — or set directly:
# DATABASE_URL=postgresql://eventflow_user:changeme_strong_password@localhost:5432/eventflow

# ─── Test Database (used only when running pytest) ───────────────────────────
TEST_DATABASE_URL=postgresql://eventflow_user:changeme_strong_password@localhost:5432/eventflow_test

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RATELIMIT_DEFAULT=200 per day;50 per hour
RATELIMIT_AUTH=10 per minute

# ─── Gunicorn (production) ───────────────────────────────────────────────────
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=120

# ─── Docker Compose only ─────────────────────────────────────────────────────
# (These are used by docker-compose.yml directly)
# POSTGRES_HOST=db  ← overridden in compose to use service name
